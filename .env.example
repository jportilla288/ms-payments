# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Application
PORT=3000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (matches docker-compose.yml)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ms_payments
DB_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ms_payments?schema=public"

# Payment gateway (sandbox). Public key is the ONLY one the SPA may ever see.
PAYMENT_API_URL=https://api-sandbox.co.uat.wompi.dev/v1
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_INTEGRITY_KEY=
PAYMENT_EVENTS_KEY=
PAYMENT_TIMEOUT_MS=15000
PAYMENT_POLL_INTERVAL_MS=1500
PAYMENT_MAX_POLL_ATTEMPTS=8
